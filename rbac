####################### Steps to Create a User in Kubernetes (via X.509 Certificates)
openssl genrsa -out erfan.pem
openssl req -new -key aref.pem -out aref.csr -subj "/CN=aref/O=devops"
# csr decoder 
kubectl api-resources | grep cert
kubectl apply -f csr.yaml
kubectl get certificatesigningrequests.certificates.k8s.io
# issue 
kubectl certificate approve aref
kubectl get certificatesigningrequests.certificates.k8s.io
# Retrieve the certificate issued by Kubernetes
kubectl get csr aref -o yaml  
kubectl get csr aref -o jsonpath='{.status.certificate}' | base64 -d > aref.crt
# rbac 
kubectl --as aref get deployments.apps  -n test
